# Finch Backend Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
# DB_PATH defaults to %LOCALAPPDATA%\Finch\data\finch.db (absolute, or a path
# relative to the backend folder if you set it yourself). LOG_DIR defaults to
# %LOCALAPPDATA%\Finch\logs. Uncomment to override either.
# DB_PATH=
# LOG_DIR=
OLLAMA_URL=http://localhost:11434
CORS_ORIGIN=http://localhost:8081,http://localhost:8080

