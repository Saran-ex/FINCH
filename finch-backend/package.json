{
  "name": "finch-backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/finalize-dist.mjs && node scripts/copy-migrations.mjs",
    "start": "node dist/index.js",
